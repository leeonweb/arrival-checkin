# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Secret password to access general staff admin area.
# Default if unset: schooladmin2026
ADMIN_PASSWORD="schooladmin2026"

# HEAD_PASSWORD: Secret password for the School Head.
# Only the School Head can generate station licenses, approve devices, and revoke devices.
# Default if unset: schoolhead2026
HEAD_PASSWORD="schoolhead2026"

# Optional: Path or raw JSON string for Firebase service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=""
